---
// Topographic contour lines drawn at build time. Deterministic, so every build matches.
interface Props { seed?: number; rings?: number; cx?: number; cy?: number }
const { seed = 7, rings = 14, cx = 760, cy = 260 } = Astro.props;

let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const lobes = Array.from({ length: 5 }, () => ({ k: 2 + Math.floor(rand() * 4), a: 0.04 + rand() * 0.1, p: rand() * Math.PI * 2 }));

const paths = Array.from({ length: rings }, (_, r) => {
  const base = 40 + r * 34;
  const pts = Array.from({ length: 96 }, (_, i) => {
    const t = (i / 96) * Math.PI * 2;
    const wobble = lobes.reduce((acc, l) => acc + l.a * Math.sin(l.k * t + l.p + r * 0.18), 0);
    const rad = base * (1 + wobble);
    return [cx + Math.cos(t) * rad * 1.35, cy + Math.sin(t) * rad];
  });
  return 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L') + 'Z';
});
---
<svg class="contours" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {paths.map((d, i) => <path d={d} class={i % 5 === 4 ? 'index' : ''} />)}
</svg>
<style>
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  path { fill: none; stroke: var(--rule); stroke-width: 1; }
  path.index { stroke: #c4bba6; stroke-width: 1.4; }
</style>
