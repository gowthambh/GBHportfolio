---
// Option A: name set large across two lines, with a spec sheet beside it.
import { site } from '../../data/site';
const [first, ...rest] = site.name.split(' ');
const specs = [
  ['Role', 'AI Engineer'],
  ['Based in', site.location],
  ['Open to', 'AI engineering roles · remote'],
  ['Now building', 'Tailrd · 50+ users'],
  ['Last role', 'AI Engineer, Q.DoTZ'],
  ['Also', 'Researcher · Consultant · Photographer'],
];
---
<section class="a">
  <div class="wrap grid">
    <div>
      <p class="mono kicker"><span class="dot"></span>Available now</p>
      <h1><span>{first}</span><span class="rest">{rest.join(' ')}</span></h1>
      <p class="line">{site.headline}</p>
      <div class="ctas">
        <a class="btn solid" href="/#work">Selected work ↓</a>
        <a class="btn" href={site.links.resume}>Resume ↓</a>
      </div>
    </div>
    <dl class="spec mono">
      {specs.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
  </div>
</section>
<style>
  .a { border-bottom: 1px solid var(--rule); }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: end; padding-top: 96px; padding-bottom: 88px; }
  .kicker { margin-bottom: 18px; }
  h1 { font-size: clamp(3.6rem, 11vw, 9rem); line-height: 0.88; letter-spacing: -0.04em; font-weight: 500; }
  h1 span { display: block; }
  h1 .rest { font-style: italic; font-weight: 400; color: var(--leaf); }
  .line { font-family: var(--serif); font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.3; margin: 28px 0 30px; max-width: 26ch; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .spec { margin: 0; border-top: 2px solid var(--ink); font-size: 0.85rem; }
  .spec div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--rule); }
  .spec dt { color: var(--muted); }
  .spec dd { margin: 0; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 40px; padding-top: 56px; } }
</style>
