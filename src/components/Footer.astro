---
import { site } from '../data/site';
const { links } = site;

// One line per hat, in the order the picker cycles through them.
const hats = [
  { role: 'AI engineer', line: 'LLM apps, voice agents, computer vision. Shipped end to end.' },
  { role: 'software engineer', line: 'From the first rough idea to the release, owned the whole way.' },
  { role: 'independent researcher', line: 'Questions without a textbook answer, like quantum ML for Alzheimer’s.' },
  { role: 'business consultant', line: 'Websites, local SEO and voice agents that fit how your business grows.' },
  { role: 'photographer', line: 'Concept shoots, planned down to the light.' },
];

const elsewhere = [
  { label: 'LinkedIn', href: links.linkedin, note: 'the formal version' },
  { label: 'GitHub', href: links.github, note: 'the receipts' },
  { label: 'Medium', href: links.medium, note: 'the long thoughts' },
  { label: 'Instagram', href: links.instagram, note: 'the photographs' },
];

// A few plants already in the ground, so the field never starts empty.
const starters = [
  { x: 0.07, h: 46, kind: 'sprout' },
  { x: 0.19, h: 70, kind: 'wheat' },
  { x: 0.34, h: 38, kind: 'sprout' },
  { x: 0.62, h: 58, kind: 'flower' },
  { x: 0.88, h: 74, kind: 'wheat' },
];
const subject = (role: string) => `Something for the ${role}`;
---
<footer id="contact" class="wrap" data-email={links.email}>
  <div class="section-head">
    <span class="mono muted">05 · Contact</span>
    <h2>Have a problem with no clear path? I’d like to hear it.</h2>
  </div>

  <div class="grid">
    <div class="ask">
      <p class="mono"><span class="dot"></span>{site.availability}</p>

      <p class="picker">
        I need the
        <button type="button" class="hat" data-hats={JSON.stringify(hats)} aria-describedby="hat-line">
          <span class="hat-role">{hats[0].role}</span><span class="spin" aria-hidden="true">↻</span>
        </button>
        <span class="sr">Press to switch which of Gowtham’s roles you need.</span>
      </p>
      <p id="hat-line" class="hat-line muted" aria-live="polite">{hats[0].line}</p>

      <div class="ctas">
        <a class="btn solid write" href={`mailto:${links.email}?subject=${encodeURIComponent(subject(hats[0].role))}`}>
          Write to me <span aria-hidden="true">→</span>
        </a>
        <button type="button" class="btn copy" data-label={links.email}>{links.email}</button>
        <a class="btn" href={links.resume}>Resume ↓</a>
      </div>
      <p class="copied mono leaf" aria-live="polite"></p>
    </div>

    <div class="side">
      <ul class="links">
        {elsewhere.map((l) => (
          <li>
            <a href={l.href} rel="me noopener" target="_blank">{l.label} <span aria-hidden="true">↗</span></a>
            <span class="note">{l.note}</span>
          </li>
        ))}
      </ul>
      <p class="clock mono muted">
        <span class="sky" aria-hidden="true">◐</span> <span class="time">Chennai, India</span>
      </p>
    </div>
  </div>

  <figure class="field" aria-labelledby="field-cap">
    <svg class="soil" viewBox="0 0 1000 150" preserveAspectRatio="none" role="img" aria-label="A strip of field with seedlings">
      <g class="plants">
        {starters.map((p) => (
          <g class={`plant ${p.kind} grown`} data-x={p.x} data-h={p.h} data-kind={p.kind}></g>
        ))}
      </g>
      <rect class="earth" x="0" y="118" width="1000" height="14" />
      <line class="ground" x1="0" y1="118" x2="1000" y2="118" />
    </svg>
    <figcaption id="field-cap" class="mono muted">
      <span class="hint">There’s no path here either. Tap the soil to plant something.</span>
      <button type="button" class="plant-btn">Plant a seed</button>
      <span class="count" aria-live="polite"></span>
    </figcaption>
  </figure>

  <p class="base mono muted">
    <span>© {new Date().getFullYear()} Gowtham B H</span>
    <span>Built by hand, no template</span>
    <a href="#top">Back to top ↑</a>
  </p>
</footer>

<script>
  const root = document.querySelector<HTMLElement>('#contact');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const email = root.dataset.email ?? '';

    /* ---- Which hat: cycles the role and rewrites the email subject to match ---- */
    const hatBtn = root.querySelector<HTMLButtonElement>('.hat')!;
    const hats: { role: string; line: string }[] = JSON.parse(hatBtn.dataset.hats ?? '[]');
    const roleEl = hatBtn.querySelector('.hat-role')!;
    const lineEl = root.querySelector('.hat-line')!;
    const write = root.querySelector<HTMLAnchorElement>('.write')!;
    let hat = 0;
    hatBtn.addEventListener('click', () => {
      hat = (hat + 1) % hats.length;
      const h = hats[hat];
      roleEl.textContent = h.role;
      lineEl.textContent = h.line;
      write.href = `mailto:${email}?subject=${encodeURIComponent(`Something for the ${h.role}`)}`;
      hatBtn.classList.remove('turn');
      void hatBtn.offsetWidth;
      hatBtn.classList.add('turn');
    });

    /* ---- Copy the address instead of opening a mail app ---- */
    const copyBtn = root.querySelector<HTMLButtonElement>('.copy')!;
    const copied = root.querySelector('.copied')!;
    let copyTimer = 0;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        copied.textContent = 'Copied. Your move.';
      } catch {
        copied.textContent = `Couldn’t copy. It’s ${email}`;
      }
      clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => (copied.textContent = ''), 3200);
    });

    /* ---- Local time in Chennai, so you know if I'm awake ---- */
    const timeEl = root.querySelector('.time')!;
    const sky = root.querySelector('.sky')!;
    const fmt = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', hour: 'numeric', minute: '2-digit', hour12: true });
    const hourFmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: 'numeric', hour12: false });
    const tick = () => {
      const now = new Date();
      const hr = Number(hourFmt.format(now));
      const night = hr < 6 || hr >= 22;
      sky.textContent = night ? '☾' : hr < 18 ? '☀' : '◐';
      timeEl.textContent = `${fmt.format(now).toLowerCase()} in Chennai · ${night ? 'probably asleep, I’ll reply in the morning' : 'probably awake'}`;
    };
    tick();
    setInterval(tick, 30_000);

    /* ---- The field ---- */
    const NS = 'http://www.w3.org/2000/svg';
    const svg = root.querySelector<SVGSVGElement>('.soil')!;
    const layer = svg.querySelector('.plants')!;
    const countEl = root.querySelector('.count')!;
    const GROUND = 118;
    const MAX = 60;
    let width = 1000;
    let planted = 0;

    const el = (tag: string, attrs: Record<string, string | number>) => {
      const n = document.createElementNS(NS, tag);
      for (const k in attrs) n.setAttribute(k, String(attrs[k]));
      return n;
    };

    // Each plant is drawn around its own base (0,0) and grows upward.
    const draw = (g: SVGGElement) => {
      const h = Number(g.dataset.h);
      const kind = g.dataset.kind;
      const bend = (Math.random() - 0.5) * 10;
      const stem = el('path', { class: 'stem', d: `M0 0 Q${bend} ${-h / 2} ${bend / 2} ${-h}` });
      const top = el('g', { transform: `translate(${bend / 2} ${-h})` });
      const bud = el('g', { class: 'bud' });
      top.append(bud);
      if (kind === 'wheat') {
        for (let i = 0; i < 5; i++) {
          bud.append(el('ellipse', { class: 'grain', cx: -3.2, cy: i * 5 - 2, rx: 2.6, ry: 4.4, transform: `rotate(-24 -3 ${i * 5})` }));
          bud.append(el('ellipse', { class: 'grain', cx: 3.2, cy: i * 5 + 0.5, rx: 2.6, ry: 4.4, transform: `rotate(24 3 ${i * 5})` }));
        }
        bud.append(el('ellipse', { class: 'grain', cx: 0, cy: -5, rx: 2.4, ry: 4.2 }));
      } else if (kind === 'flower') {
        for (let i = 0; i < 8; i++) {
          bud.append(el('ellipse', { class: 'petal', cx: 0, cy: -7, rx: 3, ry: 6, transform: `rotate(${i * 45})` }));
        }
        bud.append(el('circle', { class: 'eye', r: 4 }));
      } else {
        bud.append(el('path', { class: 'leaf-l', d: 'M0 0 C-6 -2 -14 -8 -16 -16 C-8 -14 -2 -8 0 0Z' }));
        bud.append(el('path', { class: 'leaf-r', d: 'M0 0 C6 -2 14 -8 16 -16 C8 -14 2 -8 0 0Z' }));
      }
      // .body is what leans and grows; the outer <g> only positions it on the ground.
      const body = el('g', { class: 'body' });
      if (kind !== 'sprout') {
        body.append(el('path', { class: 'leaf-l', d: `M0 ${-h * 0.35} c-5 -1 -11 -6 -12 -12 c6 1 11 5 12 12Z` }));
      }
      body.append(stem, top);
      g.replaceChildren(body);
    };

    const place = (g: SVGGElement) => {
      const x = Number(g.dataset.x) * width;
      g.setAttribute('transform', `translate(${x.toFixed(1)} ${GROUND})`);
    };

    const fit = () => {
      width = svg.clientWidth || 1000;
      svg.setAttribute('viewBox', `0 0 ${width} 150`);
      svg.querySelector('.ground')!.setAttribute('x2', String(width));
      svg.querySelector('.earth')!.setAttribute('width', String(width));
      layer.querySelectorAll<SVGGElement>('.plant').forEach(place);
    };

    layer.querySelectorAll<SVGGElement>('.plant').forEach(draw);
    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    fit();
    new ResizeObserver(fit).observe(svg);

    const notes: Record<number, string> = {
      1: 'One seed. Every farm starts like this.',
      5: 'Five. That’s a start.',
      12: 'Twelve. A small farm. The agritech dream, in miniature.',
      25: 'Twenty-five. Want to talk about it for real? Email’s up there.',
      40: 'Forty. Okay, you’re a co-founder now.',
      60: 'Sixty. The field is full. Older plants make room for new ones.',
    };
    const kinds = ['sprout', 'sprout', 'wheat', 'flower'];

    const plant = (fraction: number) => {
      const g = el('g', { class: 'plant' }) as SVGGElement;
      const kind = kinds[Math.floor(Math.random() * kinds.length)];
      g.dataset.x = String(Math.min(0.985, Math.max(0.015, fraction)));
      g.dataset.h = String(Math.round(32 + Math.random() * 52));
      g.dataset.kind = kind;
      g.classList.add(kind);
      draw(g);
      place(g);
      layer.append(g);
      if (calm.matches) g.classList.add('grown');
      const all = layer.querySelectorAll('.plant');
      if (all.length > MAX) all[0].remove();
      planted += 1;
      countEl.textContent = notes[planted] ?? `${planted} planted.`;
    };

    svg.addEventListener('pointerdown', (e) => {
      const r = svg.getBoundingClientRect();
      plant((e.clientX - r.left) / r.width);
    });
    root.querySelector('.plant-btn')!.addEventListener('click', () => plant(0.03 + Math.random() * 0.94));

    // Plants lean away from the pointer, like brushing a hand through a crop.
    if (!calm.matches) {
      let px = -1e4;
      let frame = 0;
      const sway = () => {
        frame = 0;
        layer.querySelectorAll<SVGGElement>('.plant').forEach((g) => {
          const d = Number(g.dataset.x) * width - px;
          const lean = Math.abs(d) < 90 ? Math.sign(d) * (90 - Math.abs(d)) / 6 : 0;
          g.style.setProperty('--lean', `${lean.toFixed(1)}deg`);
        });
      };
      svg.addEventListener('pointermove', (e) => {
        const r = svg.getBoundingClientRect();
        px = ((e.clientX - r.left) / r.width) * width;
        if (!frame) frame = requestAnimationFrame(sway);
      });
      svg.addEventListener('pointerleave', () => {
        px = -1e4;
        if (!frame) frame = requestAnimationFrame(sway);
      });
    }
  }
</script>

<style>
  footer { padding-top: 96px; padding-bottom: 32px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px 64px; align-items: start; }

  .picker { font-family: var(--serif); font-size: clamp(1.5rem, 3.2vw, 2.1rem); line-height: 1.2; margin: 18px 0 8px; }
  .hat {
    font: inherit; font-style: italic; color: var(--leaf); background: none; cursor: pointer;
    border: 0; border-bottom: 2px dashed var(--leaf); padding: 0 2px; margin-left: 4px;
    display: inline-flex; align-items: baseline; gap: 10px; text-align: left;
  }
  .hat:hover { background: var(--paper-2); }
  .hat:focus-visible, .copy:focus-visible, .plant-btn:focus-visible { outline: 2px solid var(--leaf); outline-offset: 3px; }
  .spin { font-style: normal; font-size: 0.6em; display: inline-block; }
  .hat.turn .spin { animation: turn 0.45s ease; }
  .hat.turn .hat-role { animation: drop 0.35s ease; }
  @keyframes turn { to { transform: rotate(360deg); } }
  @keyframes drop { from { opacity: 0; transform: translateY(-0.3em); } }
  .hat-line { max-width: 46ch; min-height: 3.3em; margin-bottom: 22px; }

  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .copy { background: none; cursor: copy; color: inherit; }
  .copied { min-height: 1.4em; margin: 10px 0 0; }

  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .links li { display: grid; }
  .links a { font-family: var(--serif); font-size: 1.25rem; text-decoration: none; }
  .links .note { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }
  .clock { margin: 26px 0 0; max-width: 30ch; }

  .field { margin: 72px 0 0; }
  .soil { display: block; width: 100%; height: 150px; cursor: crosshair; touch-action: manipulation; overflow: visible; }
  .ground { stroke: var(--ink); stroke-width: 1.2; }
  .earth { fill: var(--paper-2); }
  .field figcaption { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; padding-top: 4px; }
  .plant-btn { font: inherit; color: var(--leaf); background: none; border: 0; padding: 0; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .count { color: var(--ink); }

  /* Plants: drawn by the script, styled here. :global because the SVG children are added at runtime. */
  .soil :global(.plant) { --lean: 0deg; }
  .soil :global(.body), .soil :global(.bud) { transform-origin: 0 0; transform-box: view-box; }
  .soil :global(.stem) { fill: none; stroke: var(--leaf); stroke-width: 2; stroke-linecap: round; }
  .soil :global(.leaf-l), .soil :global(.leaf-r) { fill: var(--leaf); }
  .soil :global(.grain) { fill: #b8862a; }
  .soil :global(.petal) { fill: #d9a22e; }
  .soil :global(.eye) { fill: var(--ink); }
  .soil :global(.body) { transition: rotate 0.5s cubic-bezier(.3, 1.6, .5, 1); rotate: var(--lean); }
  .soil :global(.plant:not(.grown) .body) { animation: rise 0.9s cubic-bezier(.2, 1.4, .4, 1) both; }
  .soil :global(.plant:not(.grown) .bud) { animation: bloom 0.5s 0.55s cubic-bezier(.2, 1.6, .4, 1) both; }
  @keyframes rise { from { scale: 1 0; } }
  @keyframes bloom { from { scale: 0; } }

  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; margin: 28px 0 0; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .copy { word-break: break-all; }
    .field { margin-top: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .soil :global(.body), .soil :global(.bud), .hat .spin, .hat .hat-role { animation: none !important; transition: none !important; }
  }
</style>
