---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => b.data.order - a.data.order);
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}
const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, summary, period, role, status, noPath, stats, stack, links } = project.data;
---
<Base title={title} description={summary}>
  <article class="wrap">
    <p class="crumbs mono muted"><a href="/">Gowtham B H</a> / <a href="/#work">Work</a> / {title}</p>
    <p class="mono meta">{[period, status].filter(Boolean).join(' · ')}</p>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    {noPath && <p class="nopath"><span class="mono muted">Why there was no path</span>{noPath}</p>}
    {stats.length > 0 && (
      <dl class="stats">{stats.map((x) => (<div><dt>{x.value}</dt><dd class="mono muted">{x.label}</dd></div>))}</dl>
    )}
    <dl class="facts mono">
      {role && <div><dt class="muted">Role</dt><dd>{role}</dd></div>}
      {stack.length > 0 && <div><dt class="muted">Built with</dt><dd>{stack.join(' · ')}</dd></div>}
    </dl>
    {links.length > 0 && <p class="ctas">{links.map((l) => <a class="btn solid" href={l.href}>{l.label} ↗</a>)}</p>}
    <div class="notes"><Content /></div>
    <nav class="pager mono">
      {prev ? <a href={`/projects/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/projects/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>
<style>
  article { padding-top: 40px; }
  .crumbs a { text-decoration: none; }
  .meta { margin: 40px 0 16px; color: var(--leaf); }
  h1 { font-size: clamp(2.3rem, 6vw, 4.2rem); max-width: 18ch; }
  .summary { font-size: 1.25rem; max-width: 56ch; margin: 22px 0; }
  .nopath { max-width: 60ch; padding-left: 16px; border-left: 2px solid var(--leaf); }
  .nopath span { display: block; }
  .stats { display: flex; flex-wrap: wrap; margin: 28px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .stats div { padding: 18px 28px 18px 0; margin-right: 28px; border-right: 1px solid var(--rule); }
  .stats div:last-child { border-right: 0; }
  .stats dt { font-family: var(--serif); font-size: 1.9rem; line-height: 1.1; }
  .stats dd { margin: 4px 0 0; }
  .facts { display: grid; gap: 8px; margin: 0 0 24px; }
  .facts div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; }
  .facts dd { margin: 0; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .notes { max-width: 66ch; margin-top: 48px; }
  .notes :global(h2) { font-size: 1.6rem; margin: 44px 0 12px; padding-top: 12px; border-top: 1px solid var(--ink); }
  .notes :global(li) { margin-bottom: 6px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 72px; padding-top: 16px; border-top: 1px solid var(--rule); }
  @media (max-width: 720px) { .stats div { border-right: 0; } }
</style>
