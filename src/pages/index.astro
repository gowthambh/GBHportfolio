---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Contours from '../components/Contours.astro';
import { site, experience } from '../data/site';

const all = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => b.data.order - a.data.order);
const featured = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base>
  <section class="hero">
    <div class="wrap inner">
      <div class="copy">
        <p class="mono meta"><span class="dot"></span>{site.availability}</p>
        <h1>{site.headline}</h1>
        <p class="pitch">{site.intro} {site.pitch}</p>
        <div class="ctas">
          <a class="btn solid" href="#work">Selected work ↓</a>
          <a class="btn" href={site.links.resume}>Resume ↓</a>
        </div>
      </div>
      <figure class="map" aria-label="Contour map with a legend of the five roles">
        <div class="terrain">
          <Contours cx={600} cy={280} rings={11} />
          <span class="pin" aria-hidden="true"></span>
          <span class="here mono">You are here · Chennai<br />13.08° N, 80.27° E</span>
        </div>
        <figcaption>
          <span class="mono muted">Legend</span>
          <ul class="roles">{site.roles.map((r) => <li>{r}</li>)}</ul>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap">
    <dl class="numbers">
      {site.numbers.map((x) => (<div><dt>{x.value}</dt><dd class="muted">{x.label}</dd></div>))}
    </dl>
  </section>

  <section id="work" class="wrap section">
    <div class="section-head">
      <span class="mono muted">01 · Work</span>
      <h2>Field notes from problems with no path.</h2>
    </div>
    {featured.map((p, i) => (
      <article class="entry">
        <div class="side mono">
          <span class="num">N°{n(i)}</span>
          {p.data.period && <span>{p.data.period}</span>}
          {p.data.status && <span class="leaf">{p.data.status}</span>}
        </div>
        <div class="body">
          <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
          <p class="summary">{p.data.summary}</p>
          {p.data.noPath && (
            <p class="nopath"><span class="mono muted">Why there was no path</span>{p.data.noPath}</p>
          )}
          {p.data.stats.length > 0 && (
            <dl class="stats">
              {p.data.stats.map((x) => (<div><dt>{x.value}</dt><dd class="mono muted">{x.label}</dd></div>))}
            </dl>
          )}
          <ul class="tags">{p.data.stack.map((t) => <li>{t}</li>)}</ul>
          <p class="links mono">
            <a href={`/projects/${p.id}/`}>Read the notes →</a>
            {p.data.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}
          </p>
        </div>
      </article>
    ))}

    <h3 class="more-title">More things I’ve built</h3>
    <ol class="more">
      {more.map((p, i) => (
        <li>
          <span class="mono muted">{n(i + featured.length)}</span>
          <a href={`/projects/${p.id}/`}>{p.data.title}</a>
          <span class="muted line">{p.data.summary}</span>
          <span class="mono muted when">{p.data.period}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="experience" class="wrap section">
    <div class="section-head">
      <span class="mono muted">02 · Experience</span>
      <h2>From research labs to client work.</h2>
    </div>
    <ol class="xp">
      {experience.map((x) => (
        <li>
          <div class="mono muted"><span>{x.period}</span><br /><span>{x.place}</span></div>
          <div>
            <h3>{x.role} <span class="muted">at {x.org}</span></h3>
            <p>{x.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="teams" class="wrap section">
    <div class="section-head">
      <span class="mono muted">03 · Teams</span>
      <h2>Different teams, same job.</h2>
    </div>
    <p class="lead">{site.teamsNote}</p>
    <ul class="teams">
      {site.teams.map((t) => (<li><h3>{t.name}</h3><p class="muted">{t.text}</p></li>))}
    </ul>
  </section>

  <section id="skills" class="wrap section">
    <div class="section-head">
      <span class="mono muted">04 · Skills</span>
      <h2>The stack behind the work.</h2>
    </div>
    <div class="skills">
      {site.skills.map((g) => (
        <div>
          <h3 class="mono">{g.area}</h3>
          <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>
    <aside class="vision">
      <span class="mono muted">Where I’m headed</span>
      <p>{site.vision}</p>
    </aside>
  </section>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero .inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; padding-top: 64px; padding-bottom: 72px; }
  .meta { margin-bottom: 24px; }
  h1 { font-size: clamp(2.4rem, 5vw, 4.1rem); font-weight: 450; max-width: 15ch; text-wrap: balance; }
  .pitch { font-size: 1.15rem; max-width: 52ch; margin: 26px 0 30px; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }

  .map { margin: 0; border: 1px solid var(--ink); background: var(--paper); }
  .terrain { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--ink); }
  .pin { position: absolute; left: 50%; top: 50%; width: 11px; height: 11px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--leaf); box-shadow: 0 0 0 5px rgba(46, 90, 60, 0.18); }
  .here { position: absolute; left: calc(50% + 14px); top: calc(50% + 10px); font-size: 0.7rem; line-height: 1.4; color: var(--ink); background: var(--paper); padding: 2px 4px; }
  figcaption { padding: 14px 16px 16px; }
  .roles { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 16px; font-size: 0.92rem; }
  .roles li::before { content: '— '; color: var(--leaf); }
  @media (max-width: 860px) {
    .hero .inner { grid-template-columns: 1fr; gap: 40px; padding-top: 40px; }
  }
  @media (max-width: 420px) { .roles { grid-template-columns: 1fr; } }

  .numbers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 0; background: var(--rule); border-bottom: 1px solid var(--rule); }
  .numbers div { background: var(--paper); padding: 28px 20px 26px; }
  .numbers div:first-child { padding-left: 0; }
  .numbers dt { font-family: var(--serif); font-size: 2.4rem; line-height: 1; font-variant-numeric: lining-nums; }
  .numbers dd { margin: 10px 0 0; font-size: 0.9rem; max-width: 22ch; }
  @media (max-width: 820px) {
    .numbers { grid-template-columns: 1fr 1fr; }
    .numbers div:nth-child(odd) { padding-left: 0; }
  }

  .entry { display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding: 36px 0 44px; border-top: 1px solid var(--rule); }
  .side { display: flex; flex-direction: column; gap: 4px; color: var(--muted); }
  .num { color: var(--ink); font-size: 0.95rem; }
  .entry h3 { font-size: clamp(1.7rem, 3.2vw, 2.3rem); }
  .entry h3 a { text-decoration: none; }
  .summary { font-size: 1.12rem; max-width: 60ch; margin-top: 12px; }
  .nopath { max-width: 60ch; padding-left: 16px; border-left: 2px solid var(--leaf); }
  .nopath span { display: block; margin-bottom: 2px; }
  .stats { display: flex; flex-wrap: wrap; gap: 0; margin: 22px 0; }
  .stats div { padding-right: 28px; margin-right: 28px; border-right: 1px solid var(--rule); }
  .stats div:last-child { border-right: 0; }
  .stats dt { font-family: var(--serif); font-size: 1.7rem; line-height: 1.1; font-variant-numeric: lining-nums; }
  .stats dd { margin: 4px 0 0; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 18px; }
  @media (max-width: 720px) {
    .entry { grid-template-columns: 1fr; gap: 10px; }
    .side { flex-direction: row; flex-wrap: wrap; gap: 4px 14px; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .stats div { border: 0; margin: 0; padding: 0; }
  }

  .more-title { font-size: 1.5rem; margin: 40px 0 8px; }
  .more { list-style: none; padding: 0; margin: 0; }
  .more li { display: grid; grid-template-columns: 40px minmax(180px, 300px) 1fr auto; gap: 16px; padding: 16px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .more a { font-weight: 500; }
  .more .line { font-size: 0.95rem; }
  @media (max-width: 820px) {
    .more li { grid-template-columns: 32px 1fr; }
    .more .line, .more .when { grid-column: 2; }
  }

  .xp { list-style: none; padding: 0; margin: 0; }
  .xp li { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--rule); }
  .xp h3 { font-size: 1.35rem; margin-bottom: 8px; }
  .xp p { max-width: 64ch; }
  @media (max-width: 720px) { .xp li { grid-template-columns: 1fr; gap: 6px; } }

  .lead { font-size: 1.2rem; max-width: 52ch; }
  .teams { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule); }
  .teams li { padding: 22px 24px 10px 0; border-bottom: 1px solid var(--rule); }
  .teams li:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--rule); }
  .teams h3 { font-size: 1.25rem; margin-bottom: 6px; }
  @media (max-width: 720px) {
    .teams { grid-template-columns: 1fr; }
    .teams li:nth-child(even) { padding-left: 0; border-left: 0; }
  }

  .skills { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .skills h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--leaf); margin-bottom: 12px; }
  .skills ul { list-style: none; padding: 0; margin: 0; }
  .skills li { padding: 5px 0; border-bottom: 1px dotted var(--rule); font-size: 0.95rem; }
  @media (max-width: 820px) { .skills { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .skills { grid-template-columns: 1fr; } }

  .vision { margin-top: 72px; padding: 28px 32px; background: var(--paper-2); border-left: 3px solid var(--leaf); }
  .vision p { font-family: var(--serif); font-size: 1.35rem; line-height: 1.4; margin: 8px 0 0; max-width: 46ch; }
</style>
